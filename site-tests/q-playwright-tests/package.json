    "test:functional": "playwright test tests/functional",
    "test:ui": "playwright test tests/ui",
    "test:mobile": "playwright test tests/mobile",
    "test:accessibility": "playwright test tests/accessibility",
    "test:security": "playwright test tests/security",
    "test:database": "playwright test tests/database",
    "test:seo": "playwright test tests/seo",
    "test:billing": "playwright test tests/paypal tests/subscriptions",
    "test:ai": "playwright test tests/ai",
    "test:performance": "playwright test tests/performance",
    "test:regression": "playwright test tests/regression",
    "test:uat": "playwright test tests/uat",
    "test:list": "playwright test --list",
    "setup:supabase-users": "tsx scripts/create-supabase-test-users.ts",
    "test:headed": "playwright test --headed",
