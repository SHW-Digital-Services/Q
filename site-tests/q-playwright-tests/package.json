{
  "name": "q-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end and API tests for the Q application in D:/Dev/Q",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
