BASE_URL=http://127.0.0.1:3000
# Required for any non-local BASE_URL. Never enable this for production.
ALLOW_REMOTE_TESTS=0

# Supabase values used by API and authenticated browser tests.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side setup only. Remove after creating test users.
TEST_SUPABASE_SERVICE_ROLE_KEY=
ALLOW_TEST_USER_SETUP=0
CONFIRM_TEST_PROJECT_REF=

# Dedicated, non-production test accounts.
FREE_USER_EMAIL=
FREE_USER_PASSWORD=
SUBSCRIBER_EMAIL=
SUBSCRIBER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional PayPal sandbox values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
