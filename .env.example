# Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=anon-public-key
# For server-side writes use a Supabase service_role key. Store this securely and never expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# BetterStack
BETTERSTACK_API_KEY=rs_xxx
BETTERSTACK_STATUS_PAGE_ID=your_status_page_id
# Optional: override base hosts (usually not needed)
# BETTERSTACK_INCIDENTS_BASE=https://incidents.betterstack.com/api/v3
# BETTERSTACK_STATUS_BASE=https://status.betterstack.com/api/v2

# Vercel
VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret

# Service
PORT=3000

# Notes:
# - Do NOT commit real secrets. Use your CI/CD or platform secret manager to inject these values in production.
