# Canonical public origin. Required and HTTPS in production (for example https://www.q-ai.online).
APP_URL=http://localhost:3000
# Zoho Mail CRM portal (server-only; never prefix these with VITE_).
# Register a Self Client as office@q-ai.online at https://api-console.zoho.eu/
# Generate its refresh token with scripts/setup-zoho-office.ps1.
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REGION=eu
# Generate 32 random bytes as 64 hex characters. Shared across all server instances.
# Rotating this key invalidates uploaded attachment proofs. Mail is not stored in Supabase.
ZOHO_MAIL_COOKIE_KEY=
# Set only to the exact reverse proxy CIDR/range that supplies client addresses.
# Leave unset when Express is directly internet-facing.
TRUSTED_PROXY=
# Privileged mutations require AAL2 and a recently issued session.
PRIVILEGED_SESSION_MAX_AGE_SECONDS=900
AI_HOSTED_ENABLED=true
AI_ALLOWED_MODELS=gpt-5-nano,gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_FREE_MODEL=gpt-5-nano
AI_PAID_MODEL=gpt-5-mini
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ALLOWED_MODELS=openai/gpt-oss-20b
PAYPAL_ENV=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_PLAN_ID_MONTHLY=
PAYPAL_SANDBOX_PLAN_ID_YEARLY=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_PLAN_ID_MONTHLY=
PAYPAL_LIVE_PLAN_ID_YEARLY=
PAYPAL_LIVE_WEBHOOK_ID=
SUPABASE_SERVICE_ROLE_KEY=
VITE_APP_ACCESS_ENABLED=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# Public Brevo website tracker client key; the supplied Q key is the default.
VITE_BREVO_CLIENT_KEY=2v6dwksxycatar2dj3vmcuqd

# Optional direct PostgreSQL analytics script only (not needed by the web app).
# Remote connections require verified TLS. Never use a VITE_ prefix here.
DATABASE_URL=
# Absolute path to the CA certificate downloaded from Supabase Database Settings.
DATABASE_SSL_CA_FILE=

# Private mailbox, available only to the Q login scott@q-ai.online.
# Use a separate Zoho Self Client refresh token authorised as Scott.
ZOHO_SCOTT_MAIL_CLIENT_ID=
ZOHO_SCOTT_MAIL_CLIENT_SECRET=
ZOHO_SCOTT_MAIL_REFRESH_TOKEN=
ZOHO_SCOTT_MAIL_REGION=eu
ZOHO_SCOTT_MAIL_COOKIE_KEY=
