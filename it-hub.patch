diff --git a/it-hub/src/routes/incidents.ts b/it-hub/src/routes/incidents.ts
new file mode 100644
index 0000000..b4312ca
--- /dev/null
+++ b/it-hub/src/routes/incidents.ts
@@ -0,0 +1,41 @@
+import { Request, Response } from 'express';
+import { createIncident, updateIncident, getStatusPage } from '../services/betterstack';
+import { logEvent, getRecentEvents } from '../services/supabase_server';
+
+export async function createIncidentHandler(req: Request, res: Response) {
+  const { title, details, metadata, requester_email } = req.body;
+  if (!title) return res.status(400).json({ error: 'title required' });
+
+  try {
+    const created = await createIncident({ title, details, metadata, requester_email });
+    await logEvent('incident_created', created);
+    res.status(201).json(created);
+  } catch (err) {
+    console.error(err);
+    res.status(500).json({ error: 'failed to create incident' });
+  }
+}
+
+export async function updateIncidentHandler(req: Request, res: Response) {
+  const id = req.params.id;
+  const { status, message } = req.body;
+  try {
+    const updated = await updateIncident(id, { status, message });
+    await logEvent('incident_update', updated);
+    res.json(updated);
+  } catch (err) {
+    console.error(err);
+    res.status(500).json({ error: 'failed to update incident' });
+  }
+}
+
+export async function getStatusHandler(req: Request, res: Response) {
+  try {
+    const statusPage = await getStatusPage(process.env.BETTERSTACK_STATUS_PAGE_ID);
+    const events = await getRecentEvents(50);
+    res.json({ statusPage, recentEvents: events });
+  } catch (err) {
+    console.error(err);
+    res.status(500).json({ error: 'failed to fetch status' });
+  }
+}

diff --git a/it-hub/src/server.ts b/it-hub/src/server.ts
new file mode 100644
index 0000000..14e9220
--- /dev/null
+++ b/it-hub/src/server.ts
@@ -0,0 +1,27 @@
+import express from 'express';
+import bodyParser from 'body-parser';
+import { handleVercelWebhook } from './webhooks/vercel';
+import { createIncidentHandler, updateIncidentHandler, getStatusHandler } from './routes/incidents';
+import { requireAuth } from './utils/auth';
+
+const app = express();
+
+// Capture raw request body for webhook signature verification
+app.use(bodyParser.json({
+  verify: (req: any, res, buf: Buffer) => {
+    req.rawBody = buf;
+  }
+}));
+
+// Vercel webhook receives raw body; handler will verify signature from req.rawBody
+app.post('/webhooks/vercel', handleVercelWebhook);
+
+// Protect incident management and status endpoints
+app.post('/incidents', requireAuth, createIncidentHandler);
+app.patch('/incidents/:id', requireAuth, updateIncidentHandler);
+app.get('/status', requireAuth, getStatusHandler);
+
+const port = process.env.PORT || 3000;
+app.listen(port, () => {
+  console.log(`IT Hub listening on ${port}`);
+});

diff --git a/it-hub/src/services/betterstack.ts b/it-hub/src/services/betterstack.ts
new file mode 100644
index 0000000..7f10252
--- /dev/null
+++ b/it-hub/src/services/betterstack.ts
@@ -0,0 +1,141 @@
+import axios, { AxiosInstance } from 'axios';
+
+const API_KEY = process.env.BETTERSTACK_API_KEY;
+if (!API_KEY) throw new Error('Missing BETTERSTACK_API_KEY env var');
+
+const INCIDENTS_BASE = process.env.BETTERSTACK_INCIDENTS_BASE || 'https://incidents.betterstack.com/api/v3';
+const INCIDENT_ACTIONS_BASE = process.env.BETTERSTACK_INCIDENT_ACTIONS_BASE || 'https://uptime.betterstack.com/api/v3';
+const COMMENTS_BASE = process.env.BETTERSTACK_COMMENTS_BASE || 'https://uptime.betterstack.com/api/v2';
+const STATUS_BASE = process.env.BETTERSTACK_STATUS_BASE || 'https://status.betterstack.com/api/v2';
+
+const client: AxiosInstance = axios.create({
+  headers: {
+    Authorization: `Bearer ${API_KEY}`,
+    'Content-Type': 'application/json'
+  },
+  timeout: 10000
+});
+
+/**
+ * Create an incident using BetterStack Incidents API v3.
+ * Uses the documented top-level v3 fields.
+ */
+export async function createIncident(payload: {
+  title: string;
+  details?: string;
+  metadata?: any;
+  requester_email?: string;
+}) {
+  const requesterEmail = payload.requester_email || process.env.BETTERSTACK_REQUESTER_EMAIL;
+  if (!requesterEmail) throw new Error('requester_email or BETTERSTACK_REQUESTER_EMAIL is required');
+
+  const body = {
+    name: payload.title,
+    summary: payload.title,
+    requester_email: requesterEmail,
+    ...(payload.details ? { description: String(payload.details) } : {}),
+    ...(payload.metadata ? { metadata: payload.metadata } : {})
+  };
+
+  const url = `${INCIDENTS_BASE}/incidents`;
+  const resp = await client.post(url, body);
+  return resp.data;
+}
+
+/**
+ * Apply supported incident actions and post a comment using Better Stack APIs.
+ */
+export async function updateIncident(externalId: string, payload: {
+  status?: string;
+  message?: string;
+}) {
+  const incidentUrl = `${INCIDENT_ACTIONS_BASE}/incidents/${encodeURIComponent(externalId)}`;
+  let result: any;
+
+  if (payload.status) {
+    const normalizedStatus = payload.status.toLowerCase();
+    const action = normalizedStatus === 'resolved' ? 'resolve'
+      : normalizedStatus === 'acknowledged' ? 'acknowledge'
+      : null;
+    if (!action) throw new Error(`Unsupported incident status: ${payload.status}`);
+    const by = process.env.BETTERSTACK_REQUESTER_EMAIL || 'IT Hub';
+    const response = await client.post(`${incidentUrl}/${action}`, {
+      [action === 'resolve' ? 'resolved_by' : 'acknowledged_by']: by
+    });
+    result = response.data;
+  }
+
+  if (payload.message) {
+    const response = await client.post(
+      `${COMMENTS_BASE}/incidents/${encodeURIComponent(externalId)}/comments`,
+      { content: payload.message }
+    );
+    result = response.data;
+  }
+
+  if (!result) throw new Error('Provide a supported status or a message to update');
+  return result;
+}
+
+/**
+ * Create a public status page incident (v2 status API) — kept for status page updates.
+ */
+export async function createStatusPageIncident(pageId: string, payload: {
+  name: string;
+  message?: string;
+  status?: string;
+  started_at?: string;
+  metadata?: any;
+}) {
+  const body: any = {
+    incident: {
+      name: payload.name,
+      message: payload.message || '',
+      status: payload.status || 'investigating',
+      ...(payload.started_at ? { started_at: payload.started_at } : {}),
+      ...(payload.metadata ? { metadata: payload.metadata } : {})
+    }
+  };
+
+  const url = `${STATUS_BASE}/pages/${encodeURIComponent(pageId)}/incidents`;
+  const resp = await client.post(url, body);
+  return (resp.data && resp.data.incident) ? resp.data.incident : resp.data;
+}
+
+/**
+ * Post an update to a status page incident (v2)
+ */
+export async function postStatusPageUpdate(pageId: string, incidentId: string, update: {
+  message: string;
+  status?: string;
+}) {
+  const body = {
+    update: {
+      message: update.message,
+      ...(update.status ? { status: update.status } : {})
+    }
+  };
+
+  const url = `${STATUS_BASE}/pages/${encodeURIComponent(pageId)}/incidents/${encodeURIComponent(incidentId)}/updates`;
+  const resp = await client.post(url, body);
+  return (resp.data && resp.data.update) ? resp.data.update : resp.data;
+}
+
+/**
+ * Fetch status page metadata (v2)
+ */
+export async function getStatusPage(pageId?: string) {
+  const id = pageId || process.env.BETTERSTACK_STATUS_PAGE_ID;
+  if (!id) return null;
+  const url = `${STATUS_BASE}/pages/${encodeURIComponent(id)}`;
+  const resp = await client.get(url);
+  return resp.data;
+}
+
+export default {
+  createIncident,
+  updateIncident,
+  createStatusPageIncident,
+  postStatusPageUpdate,
+  getStatusPage
+};

diff --git a/it-hub/src/services/supabase_server.ts b/it-hub/src/services/supabase_server.ts
new file mode 100644
index 0000000..dc9f041
--- /dev/null
+++ b/it-hub/src/services/supabase_server.ts
@@ -0,0 +1,31 @@
+import { createClient } from '@supabase/supabase-js';
+
+const url = process.env.SUPABASE_URL;
+const serviceRole = process.env.SUPABASE_SERVICE_ROLE_KEY;
+const secretKey = process.env.SUPABASE_SECRET_KEY;
+
+if (!url) throw new Error('SUPABASE_URL missing');
+if (!secretKey && !serviceRole) throw new Error('Provide SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY');
+
+// This server needs privileged database access; never fall back to a public key.
+const supabase = createClient(url, (secretKey || serviceRole) as string, {
+  auth: { persistSession: false, autoRefreshToken: false, detectSessionInUrl: false }
+});
+
+export async function logEvent(type: string, payload: any) {
+  const { data, error } = await supabase
+    .from('it_hub_events')
+    .insert([{ type, payload }]);
+  if (error) throw error;
+  return data;
+}
+
+export async function getRecentEvents(limit = 50) {
+  const { data, error } = await supabase
+    .from('it_hub_events')
+    .select('*')
+    .order('created_at', { ascending: false })
+    .limit(limit);
+  if (error) throw error;
+  return data;
+}

diff --git a/it-hub/src/services/vercel.ts b/it-hub/src/services/vercel.ts
new file mode 100644
index 0000000..32a0667
--- /dev/null
+++ b/it-hub/src/services/vercel.ts
@@ -0,0 +1,32 @@
+import { logEvent } from './supabase_server';
+import { createIncident } from './betterstack';
+
+export async function createIncidentIfDeploymentFailed(payload: any) {
+  const eventType = payload?.type || payload?.event;
+  const failed = eventType === 'deployment.error'
+    || eventType === 'deployment-error'
+    || payload?.state === 'error'
+    || payload?.deploymentStatus === 'failed'
+    || payload?.status === 'failed';
+  if (!failed) return;
+
+  const event = payload?.payload || payload;
+  const deploymentName = event?.deployment?.name || event?.project?.name || event?.name || event?.source || 'unknown';
+  const title = `Deployment failed: ${deploymentName}`;
+  const details = JSON.stringify(event, null, 2);
+
+  try {
+    const incident = await createIncident({
+      title,
+      details,
+      metadata: { source: 'vercel' },
+      requester_email: process.env.BETTERSTACK_REQUESTER_EMAIL
+    });
+    await logEvent('incident_created_from_vercel', { payload, incident });
+    return incident;
+  } catch (err) {
+    console.error('failed to create incident from vercel payload', err);
+    await logEvent('incident_creation_error', { error: String(err), payload });
+    return null;
+  }
+}

diff --git a/it-hub/src/utils/auth.ts b/it-hub/src/utils/auth.ts
new file mode 100644
index 0000000..3f0c2f9
--- /dev/null
+++ b/it-hub/src/utils/auth.ts
@@ -0,0 +1,27 @@
+import { Request, Response, NextFunction } from 'express';
+import crypto from 'crypto';
+
+export function requireAuth(req: Request, res: Response, next: NextFunction) {
+  const configured = process.env.IT_HUB_API_KEY;
+  if (!configured) return res.status(500).json({ error: 'IT_HUB_API_KEY not configured' });
+
+  const auth = req.headers['authorization'] as string | undefined;
+  const apiKeyHeader = req.headers['x-it-hub-key'] as string | undefined;
+
+  let supplied: string | undefined;
+  if (auth && auth.startsWith('Bearer ')) supplied = auth.slice(7).trim();
+  else if (apiKeyHeader) supplied = apiKeyHeader.trim();
+
+  if (!supplied) return res.status(401).json({ error: 'missing credentials' });
+
+  try {
+    const a = Buffer.from(supplied, 'utf8');
+    const b = Buffer.from(configured, 'utf8');
+    if (a.length !== b.length) return res.status(401).json({ error: 'invalid credentials' });
+    const ok = crypto.timingSafeEqual(a, b);
+    if (!ok) return res.status(401).json({ error: 'invalid credentials' });
+    return next();
+  } catch (err) {
+    return res.status(401).json({ error: 'invalid credentials' });
+  }
+}

diff --git a/it-hub/src/utils/signature.ts b/it-hub/src/utils/signature.ts
new file mode 100644
index 0000000..dc94cb1
--- /dev/null
+++ b/it-hub/src/utils/signature.ts
@@ -0,0 +1,32 @@
+import crypto from 'crypto';
+
+// Verify Vercel webhook using HMAC-SHA1 over raw request body.
+// Accepts header forms like "sha1=<hex>" or raw hex.
+export function verifyVercelSignature(secret: string, rawBody: Buffer, signatureHeader: string) {
+  let received = signatureHeader;
+  if (received.startsWith('sha1=')) received = received.slice(5);
+
+  const hmac = crypto.createHmac('sha1', secret).update(rawBody).digest('hex');
+
+  try {
+    const sigBuf = Buffer.from(received, 'utf8');
+    const hmacBuf = Buffer.from(hmac, 'utf8');
+    if (sigBuf.length !== hmacBuf.length) return false;
+    return crypto.timingSafeEqual(sigBuf, hmacBuf);
+  } catch (e) {
+    return false;
+  }
+}
+
+// Generic HMAC-SHA256 verify kept for other webhook providers if needed
+export function verifySignature(secret: string, body: string, signatureHeader: string) {
+  const hmac = crypto.createHmac('sha256', secret).update(body).digest('hex');
+  try {
+    const sigBuf = Buffer.from(signatureHeader, 'utf8');
+    const hmacBuf = Buffer.from(hmac, 'utf8');
+    if (sigBuf.length !== hmacBuf.length) return false;
+    return crypto.timingSafeEqual(sigBuf, hmacBuf);
+  } catch (e) {
+    return false;
+  }
+}

diff --git a/it-hub/src/webhooks/vercel.ts b/it-hub/src/webhooks/vercel.ts
new file mode 100644
index 0000000..660120d
--- /dev/null
+++ b/it-hub/src/webhooks/vercel.ts
@@ -0,0 +1,29 @@
+import { Request, Response } from 'express';
+import { verifyVercelSignature } from '../utils/signature';
+import { logEvent } from '../services/supabase_server';
+import { createIncidentIfDeploymentFailed } from '../services/vercel';
+
+export async function handleVercelWebhook(req: Request & { rawBody?: Buffer }, res: Response) {
+  const secret = process.env.VERCEL_WEBHOOK_SECRET;
+  if (!secret) return res.status(500).json({ ok: false, error: 'VERCEL_WEBHOOK_SECRET not configured' });
+
+  const signatureHeader = (req.headers['x-vercel-signature'] || req.headers['x-signature']) as string | undefined;
+  if (!signatureHeader) return res.status(400).json({ ok: false, error: 'missing signature header' });
+
+  const raw = req.rawBody;
+  if (!raw) return res.status(400).json({ ok: false, error: 'raw body missing' });
+
+  const ok = verifyVercelSignature(secret, raw, signatureHeader);
+  if (!ok) return res.status(401).json({ ok: false, error: 'invalid signature' });
+
+  try {
+    // parse JSON payload from raw buffer
+    const payload = JSON.parse(raw.toString('utf8'));
+    await logEvent('vercel_deployment', payload);
+    await createIncidentIfDeploymentFailed(payload);
+    res.json({ ok: true });
+  } catch (err) {
+    console.error('vercel webhook handler error', err);
+    res.status(500).json({ ok: false, error: 'internal error' });
+  }
+}

diff --git a/it-hub/supabase/init.sql b/it-hub/supabase/init.sql
new file mode 100644
index 0000000..3829d91
--- /dev/null
+++ b/it-hub/supabase/init.sql
@@ -0,0 +1,29 @@
+-- Run this in Supabase SQL editor to create tables used by IT Hub
+create extension if not exists pgcrypto;
+
+create table if not exists it_hub_events (
+  id uuid default gen_random_uuid() primary key,
+  type text not null,
+  payload jsonb not null,
+  created_at timestamptz default now()
+);
+
+create table if not exists it_hub_incidents (
+  id uuid default gen_random_uuid() primary key,
+  external_id text,
+  title text not null,
+  status text not null,
+  details text,
+  metadata jsonb,
+  created_at timestamptz default now(),
+  updated_at timestamptz default now()
+);
+
+-- These tables are server-only. Require privileged backend credentials.
+alter table it_hub_events enable row level security;
+alter table it_hub_events force row level security;
+alter table it_hub_incidents enable row level security;
+alter table it_hub_incidents force row level security;
+
+revoke all on table it_hub_events, it_hub_incidents from public, anon, authenticated;
+grant all on table it_hub_events, it_hub_incidents to service_role;

