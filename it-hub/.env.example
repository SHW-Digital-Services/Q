# Supabase (server-only)
SUPABASE_URL=https://your-supabase-project.supabase.co
# Use a Supabase secret key or legacy service_role key. Store it securely and never expose it to clients.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# BetterStack
BETTERSTACK_API_KEY=rs_xxx
BETTERSTACK_STATUS_PAGE_ID=your_status_page_id
BETTERSTACK_REQUESTER_EMAIL=ops@example.com

# Vercel webhook secret (set identical secret in Vercel webhook config)
VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret

# IT Hub management API key (server-side only)
IT_HUB_API_KEY=replace-with-strong-api-key

PORT=3000
